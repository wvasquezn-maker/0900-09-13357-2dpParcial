
pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'MAVEN_3_9_16'
    }

    stages {
        stage('Clonar repositorio') {
            steps {
                checkout scm
            }
        }

        stage('Compilar') {
            steps {
                bat 'mvn -B -DskipTests clean package'
            }
        }

        stage('Pruebas JUnit') {
            steps {
                bat 'mvn -B test'
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Analisis SonarQube') {
            steps {
                withSonarQubeEnv('SonarQubeLocal') {
                    bat 'mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=laboratorio-jenkins-maven'
                }
            }
        }
    }

    post {
        success {
            echo 'Compilacion, pruebas y analisis completados.'
        }
        failure {
            echo 'La ejecucion fallo. Revisar Console Output.'
        }
    }
}
